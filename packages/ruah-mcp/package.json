{
  "name": "ruah-mcp",
  "version": "0.1.0",
  "description": "Ruah image tools for AI agents (MCP): on-device background removal, compression, resizing, cropping, AI upscaling and metadata removal. Images never leave your computer.",
  "homepage": "https://ruah.tools",
  "mcpName": "tools.ruah/ruah-mcp",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ruah-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@jsquash/avif": "2.1.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/oxipng": "2.3.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/resize": "2.1.1",
    "@jsquash/webp": "1.5.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "imagequant": "0.1.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
